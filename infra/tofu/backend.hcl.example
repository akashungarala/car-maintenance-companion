# Copy to backend.hcl (gitignored) and fill in from `tofu output`:
#   tofu output -raw s3_endpoint
#   tofu output -raw s3_access_key_id
#   tofu output -raw s3_secret_access_key

bucket    = "cmc-tofu-state"
region    = "us-ashburn-1"
endpoints = { s3 = "https://<NAMESPACE>.compat.objectstorage.<REGION>.oraclecloud.com" }

access_key = "<S3_ACCESS_KEY_ID>"
secret_key = "<S3_SECRET_ACCESS_KEY>"
